# GitHub Configuration
GITHUB_TOKEN=your_github_token
GITHUB_REPO_OWNER=your_username
GITHUB_REPO_NAME=your_repo

# Brevo Configuration
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_email
BREVO_SENDER_NAME=Your Name

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key

# Database Configuration
# Choose one of the following database options:

# Option 1: PostgreSQL (default)
DATABASE_URL=postgresql+asyncpg://releasebot:your_password@db:5432/releasebot
POSTGRES_USER=releasebot
POSTGRES_PASSWORD=your_password
POSTGRES_DB=releasebot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Option 2: MySQL (uncomment to use)
# DATABASE_URL=mysql+aiomysql://releasebot:your_password@db:3306/releasebot
# MYSQL_USER=releasebot
# MYSQL_PASSWORD=your_password
# MYSQL_DB=releasebot
# MYSQL_HOST=db
# MYSQL_PORT=3306

API_BASE_URL=http://localhost:8000