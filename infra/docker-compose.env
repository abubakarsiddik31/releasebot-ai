# Environment configuration for infra/docker-compose.yml
# Source this file with: source infra/docker-compose.env

# Default configuration uses PostgreSQL
# To switch to MySQL, run: source infra/docker-compose.env mysql

set_db_config() {
    local db_type=${1:-postgres}

    if [ "$db_type" = "mysql" ]; then
        echo "Switching to MySQL configuration..."
        export DB_IMAGE="mysql:8.0"
        export DB_PORT="3306"
        export DB_VOLUME_NAME="mysql_data"
        export DB_VOLUME_PATH="/var/lib/mysql"
        export DB_ENV_VARS="\
MYSQL_ROOT_PASSWORD=root_password \
MYSQL_DATABASE=releasebot \
MYSQL_USER=releasebot \
MYSQL_PASSWORD=password"
        export DB_HEALTH_CHECK="\
[\"CMD\", \"mysqladmin\", \"ping\", \"-h\", \"localhost\", \"-u\", \"root\", \"-proot_password\"]"
        export DATABASE_URL="mysql+aiomysql://releasebot:password@db:3306/releasebot"
    else
        echo "Switching to PostgreSQL configuration..."
        export DB_IMAGE="postgres:15-alpine"
        export DB_PORT="5432"
        export DB_VOLUME_NAME="postgres_data"
        export DB_VOLUME_PATH="/var/lib/postgresql/data"
        export DB_ENV_VARS="\
POSTGRES_USER=releasebot \
POSTGRES_PASSWORD=password \
POSTGRES_DB=releasebot"
        export DB_HEALTH_CHECK="\
[\"CMD-SHELL\", \"pg_isready -U releasebot -d releasebot\"]"
        export DATABASE_URL="postgresql+asyncpg://releasebot:password@db:5432/releasebot"
    fi
}

set_db_config postgres

if [ "$1" = "mysql" ]; then
    set_db_config mysql
elif [ "$1" = "postgres" ]; then
    set_db_config postgres
fi

echo "Database configuration set to: ${DB_IMAGE}"
echo "To start the application, run: docker compose -f infra/docker-compose.yml up -d"
